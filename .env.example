# --- Local development (Docker Postgres) ---
DATABASE_LOCAL_URL=postgresql://vantrans82:vantrans82_dev@localhost:5432/vantrans82_local

# --- Vercel Postgres (auto-injected when you add Storage in the Vercel project) ---
# POSTGRES_URL=              # pooled — used in production (preferred on Vercel)
# POSTGRES_URL_NON_POOLING=  # direct — migrations / one-off scripts only
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_DATABASE=

# Optional: set DATABASE_URL to the same value as POSTGRES_URL if you prefer one name
# DATABASE_URL=

# Railway (legacy; not used on Vercel)
# DATABASE_PRIVATE_URL=
