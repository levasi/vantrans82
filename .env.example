# Local development (Docker Postgres)
DATABASE_LOCAL_URL=postgresql://vantrans82:vantrans82_dev@localhost:5432/vantrans82_local

# Production (Vercel / Railway / Neon / Vercel Postgres)
# Set in Vercel: Project → Settings → Environment Variables
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: private network URL (Railway only; not used on Vercel)
# DATABASE_PRIVATE_URL=
